{
  "name": "docforge-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DocForge AI — SaaS de production documentaire (stack 100% gratuite)",
  "workspaces": [
    "modules/*",
    "shared/*"
  ],
  "scripts": {
    "test": "node --test",
    "test:module": "node --test modules/%npm_config_module%/tests/",
    "verify": "node scripts/verify-env.js",
    "lint": "eslint modules shared --ext .js",
    "dev": "docker compose -f infra/docker-compose.yml up -d",
    "dev:down": "docker compose -f infra/docker-compose.yml down",
    "scaffold": "node scaffold-docforge.js",
    "start": "node scripts/start-all.js",
    "start:all": "node scripts/start-all.js --all",
    "fixes": "node apply-all-fixes.mjs"
  },
  "engines": {
    "node": ">=20.20.0 <21",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "eslint": "^9.10.0"
  },
  "overrides": {
    "nanoid": "5.1.6",
    "content-disposition": "0.5.4"
  },
  "dependencies": {
    "fs-extra": "11.4.1"
  }
}