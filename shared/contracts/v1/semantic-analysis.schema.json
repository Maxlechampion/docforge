{
  "$id": "https://docforge.ai/schemas/v1/semantic-analysis.json",
  "type": "object",
  "required": [
    "version",
    "blocks"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "type",
          "content"
        ],
        "properties": {
          "level": {
            "enum": [
              "h1",
              "h2",
              "h3",
              "body",
              "caption"
            ]
          },
          "type": {
            "enum": [
              "text",
              "list",
              "table",
              "quote"
            ]
          },
          "content": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array"
            }
          }
        }
      }
    },
    "fallback_used": {
      "type": "boolean",
      "default": false
    }
  }
}